Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fun", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"s1", "*", "x", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"s2", "*", "y"}], "-", "x"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"Sign", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Whether", " ", "or", " ", "not", " ", "the", " ", "bifurcation", " ", 
       "is", " ", 
       RowBox[{"forward", "/", "backward"}], " ", "is", " ", "already", " ", 
       "determined", " ", "using", " ", "sols"}], ",", " ", 
      RowBox[{
      "so", " ", "a", " ", "is", " ", "not", " ", "important", " ", "in", " ",
        "the", " ", "plot"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"b", "=", 
     RowBox[{"Sign", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x", ",", "y"}], "]"}], "]"}]}],
     ";", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "direction", " ", "of", " ", "change", " ", "of", " ", 
       "stability", " ", "is", " ", "however", " ", "important"}], ",", " ", 
      RowBox[{
       RowBox[{
       "and", " ", "is", " ", "included", " ", "by", " ", "multiplying", " ", 
        "the", " ", "equilibria", " ", "with"}], " ", "-", "b"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"sols", " ", "=", " ", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
       RowBox[{"{", "x", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ineqa", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"a", ">", "0"}], ",", "\"\<>\>\"", ",", "\"\<<\>\""}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"ineqb", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"b", ">", "0"}], ",", "\"\<>\>\"", ",", "\"\<<\>\""}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"title", "=", 
     RowBox[{
      RowBox[{
      "StringTemplate", 
       "[", "\"\<\[PartialD]\.b2f/\[PartialD]x\.b2(0,0)`1`0, \
\[PartialD]\.b2f/(\[PartialD]\[Mu]\[PartialD]x)(0,0)`2`0\>\"", "]"}], "[", 
      RowBox[{"ineqa", ",", "ineqb"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "TFPlot", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"s1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s2", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], "Input",
