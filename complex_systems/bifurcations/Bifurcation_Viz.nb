Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fun", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"s1", "*", "y"}], "-", 
     RowBox[{"s2", "*", 
      RowBox[{"x", "^", "2"}]}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"Sign", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"b", "=", 
     RowBox[{"Sign", "[", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "]"}]}], ";", " ",
     "\[IndentingNewLine]", 
    RowBox[{"sols", " ", "=", " ", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fun", "[", 
         RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
       RowBox[{"{", "y", "}"}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "Need", " ", "to", " ", "solve", " ", "for", " ", "y", " ", "instead", " ",
       "in", " ", "order", " ", "not", " ", "to", " ", "get", " ", 
      "imaginary", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"ineqa", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"a", ">", "0"}], ",", "\"\<>\>\"", ",", "\"\<<\>\""}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"ineqb", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"b", ">", "0"}], ",", "\"\<>\>\"", ",", "\"\<<\>\""}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"title", "=", 
     RowBox[{
      RowBox[{
      "StringTemplate", 
       "[", "\"\<\[PartialD]\.b2f/\[PartialD]x\.b2(0,0)`1`0, \[PartialD]f/\
\[PartialD]\[Mu](0,0)`2`0\>\"", "]"}], "[", 
      RowBox[{"ineqa", ",", "ineqb"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "FPlot", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"s1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s2", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], "Input",
